{
  "paidEnv": "AGENTMESH_PAID",
  "tiers": {
    "local": [
      {
        "backend": "ollama",
        "model": "llama3.1:8b"
      },
      {
        "backend": "nvidia",
        "model": "meta/llama-3.3-70b-instruct"
      },
      {
        "backend": "claude",
        "model": "sonnet"
      }
    ],
    "cheap": [
      {
        "backend": "nvidia",
        "model": "meta/llama-3.3-70b-instruct"
      },
      {
        "backend": "claude",
        "model": "sonnet"
      },
      {
        "backend": "openrouter",
        "model": "deepseek/deepseek-chat"
      },
      {
        "backend": "ollama",
        "model": "llama3.1:8b"
      }
    ],
    "research": [
      {
        "backend": "nvidia",
        "model": "deepseek-ai/deepseek-v4-flash"
      },
      {
        "backend": "claude",
        "model": "sonnet"
      },
      {
        "backend": "openrouter",
        "model": "google/gemini-2.5-flash"
      },
      {
        "backend": "ollama",
        "model": "llama3.1:8b"
      }
    ],
    "code": [
      {
        "backend": "claude",
        "model": "sonnet"
      },
      {
        "backend": "nvidia",
        "model": "qwen/qwen3.5-122b-a10b"
      },
      {
        "backend": "codex",
        "model": "gpt-5"
      },
      {
        "backend": "openrouter",
        "model": "deepseek/deepseek-chat"
      }
    ],
    "frontier": [
      {
        "backend": "claude",
        "model": "opus"
      },
      {
        "backend": "nvidia",
        "model": "deepseek-ai/deepseek-v4-pro"
      },
      {
        "backend": "codex",
        "model": "gpt-5"
      },
      {
        "backend": "openrouter",
        "model": "deepseek/deepseek-r1"
      }
    ]
  },
  "fusion": {
    "autoCheapIntents": [
      "research",
      "search",
      "market"
    ],
    "_autoCheapIntents": "intents donde mesh AUTO-LANZA el panel barato SIN preguntar (~0.5c, no sensible). Vaciar [] = volver a solo-sugerir. El premium (--fusion-pro) NUNCA es automatico.",
    "cheap": {
      "analysis_models": [
        "deepseek/deepseek-chat",
        "google/gemini-2.5-flash",
        "moonshotai/kimi-k2.6"
      ],
      "judge": "deepseek/deepseek-chat"
    },
    "_pro_note": "OpenAI (gpt-5.x/4.1) da 'Provider returned error' en esta key (necesita BYOK). Panel premium viable y diverso sin OpenAI. Reañadir un openai/* solo si se configura el provider key en OpenRouter.",
    "pro": {
      "analysis_models": [
        "anthropic/claude-opus-4.8",
        "google/gemini-2.5-pro",
        "deepseek/deepseek-r1"
      ],
      "judge": "anthropic/claude-opus-4.8"
    }
  },
  "availability": {
    "ollama": {
      "cmd": "ollama"
    },
    "claude": {
      "cmd": "claude"
    },
    "gemini": {
      "cmd": "gemini",
      "anyOf": [
        {
          "env": "GEMINI_API_KEY"
        },
        {
          "file": "~/.gemini/oauth_creds.json"
        },
        {
          "file": "~/.gemini/google_accounts.json"
        }
      ]
    },
    "codex": {
      "cmd": "codex",
      "anyOf": [
        {
          "file": "~/.codex/auth.json"
        },
        {
          "file": "~/.config/codex/auth.json"
        },
        {
          "env": "OPENAI_API_KEY"
        }
      ]
    },
    "openrouter": {
      "anyOf": [
        {
          "env": "OPENROUTER_API_KEY"
        }
      ]
    },
    "nvidia": {
      "anyOf": [
        {
          "env": "NVIDIA_API_KEY"
        }
      ]
    }
  },
  "routes": [
    {
      "when": {
        "privacy": "sensitive"
      },
      "use": "local",
      "why": "datos sensibles -> nunca a la nube"
    },
    {
      "when": {
        "intent": [
          "format",
          "classify",
          "extract",
          "translate",
          "rename",
          "local-bulk"
        ],
        "complexity": [
          "trivial",
          "medium"
        ]
      },
      "use": "local",
      "why": "mecanico/volumen -> modelo local gratis"
    },
    {
      "when": {
        "intent": [
          "summarize",
          "draft",
          "email"
        ],
        "complexity": [
          "trivial",
          "medium"
        ]
      },
      "use": "cheap",
      "why": "texto medio -> tier barato"
    },
    {
      "when": {
        "intent": [
          "research",
          "search",
          "market"
        ]
      },
      "use": "research",
      "why": "research/contexto grande"
    },
    {
      "when": {
        "intent": [
          "code-edit",
          "code-review",
          "refactor",
          "tests",
          "bugfix"
        ]
      },
      "use": "code",
      "why": "codigo en repo"
    },
    {
      "when": {
        "intent": [
          "reason",
          "architecture",
          "debug-hard",
          "plan",
          "strategy"
        ],
        "complexity": [
          "hard"
        ]
      },
      "use": "frontier",
      "why": "razonamiento dificil"
    },
    {
      "default": "cheap",
      "why": "por defecto, el tier barato (nunca Opus por defecto)"
    }
  ],
  "machineRules": [
    {
      "default": "mac",
      "why": "Local by default; the routing tiers stay machine-agnostic."
    }
  ],
  "backends": {
    "ollama": {
      "argv": [
        "ollama",
        "run",
        "{model}"
      ],
      "stdin": true,
      "remoteOk": true
    },
    "claude": {
      "argv": [
        "claude",
        "-p",
        "--model",
        "{model}"
      ],
      "stdin": true,
      "remoteOk": true
    },
    "codex": {
      "argv": [
        "codex",
        "exec",
        "{prompt}"
      ],
      "stdin": false,
      "remoteOk": false
    },
    "gemini": {
      "argv": [
        "gemini",
        "-p",
        "{prompt}"
      ],
      "stdin": false,
      "remoteOk": false
    },
    "openrouter": {
      "argv": [
        "__openrouter_api__"
      ],
      "stdin": true,
      "remoteOk": false
    },
    "nvidia": {
      "argv": [
        "__nvidia_api__"
      ],
      "stdin": true,
      "remoteOk": false
    }
  },
  "machines": {
    "mac": {
      "type": "local",
      "meshPath": "~/mac-setup/agentmesh/agentmesh.mjs"
    }
  }
}